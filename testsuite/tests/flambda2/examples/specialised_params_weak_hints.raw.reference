let code inline(always) size(1)
      inline_helper (p : val, x : val) specialised { p = p_slot }
        my_closure &my_alloc_region my_depth
        -> k * e
        : val =
  cont k (x)
in
let code size(20)
      metadata_only (x : val)
        my_closure &my_alloc_region my_depth
        -> k * e
        : val =
  let captured = %block.[`0`].my_alloc_region (x) in
  let carrier =
    closure specialisation_site inline_helper &my_alloc_region
      synthetic { p_slot = captured }
  in
  apply direct(inline_helper &my_alloc_region) carrier (captured, x) -> k * e
in
let code inline(never) size(1)
      live_helper (x : val)
        my_closure &my_alloc_region my_depth
        -> k * e
        : val =
  cont k (x)
in
let code size(30)
      mutable_alias (x : val, n : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : val =
  let r = %block.mut.[`0`].my_alloc_region (x) in
  cont loop (r, n)
    where rec loop (r_alias : val, i : imm tagged) =
      let carrier =
        closure specialisation_site live_helper &my_alloc_region
          synthetic { removed_slot = r_alias }
      in
      let stop = %int_comp.le (i, 0) in
      (switch stop
         | 0 -> next
         | 1 -> finish
         where next =
           let set = %block_set.[`0`] (r_alias, i) in
           let pred = %int_barith.sub (i, 1) in
           cont loop (r_alias, pred)
         where finish =
           let value = %block_load.mut.[`0`] (r_alias) in
           apply direct(live_helper &my_alloc_region)  (value) -> k * e)
in
let $metadata_only = closure metadata_only &toplevel.alloc_region in
let $mutable_alias = closure mutable_alias &toplevel.alloc_region in
let $camlSpecialised_params_weak_hints =
  Block 0 ($metadata_only, $mutable_alias)
in
cont done ($camlSpecialised_params_weak_hints)
