let code inline_helper deleted in
let code metadata_only deleted in
let code live_helper deleted in
let code mutable_alias deleted in
let code inline(always) loopify(never) size(1) newer_version_of(inline_helper)
      inline_helper_1 (p : val, x : val) specialised { p = p_slot }
        my_closure &my_alloc_region my_depth
        -> k * e
        : val =
  cont k (x)
in
let code loopify(never) size(10) newer_version_of(metadata_only)
      metadata_only_1 (x : val)
        my_closure &my_alloc_region my_depth
        -> k * e
        : val =
  let carrier =
    closure specialisation_site inline_helper_1 @inline_helper
      &my_alloc_region
  in
  cont k (x)
in
let $metadata_only =
  closure metadata_only_1 @metadata_only &toplevel.alloc_region
in
let code live_helper_1 deleted in
let code inline(never) loopify(never) size(1) newer_version_of(live_helper_1)
      live_helper_2 (x : val)
        my_closure &my_alloc_region my_depth
        -> k * e
        : val =
  cont k (x)
in
let code loopify(never) size(28) newer_version_of(mutable_alias)
      mutable_alias_1 (x : val, n : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : val =
  cont loop (n, x)
    where rec loop (i : imm tagged, r_0) =
      let carrier =
        closure specialisation_site live_helper_2 @live_helper
          &my_alloc_region
      in
      let stop = %int_comp.le (i, 0) in
      (switch stop
         | 0 -> next
         | 1 -> finish
         where next =
           let pred = %int_barith.sub (i, 1) in
           cont loop (pred, i)
         where finish =
           apply direct(live_helper_2 &my_alloc_region)  (r_0) -> k * e)
in
let $mutable_alias =
  closure mutable_alias_1 @mutable_alias &toplevel.alloc_region
in
let $camlSpecialised_params_weak_hints =
  Block 0 ($metadata_only, $mutable_alias)
in
cont done ($camlSpecialised_params_weak_hints)
