; Verify simple_multipart.exe has multiple partitions
(rule
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (target simple_multipart.sections)
 (deps simple_multipart.exe)
 (action (with-outputs-to %{target}
   (run readelf -S %{deps}))))

; Verify simple_multipart.exe has exactly 1 partition (simple.ml alone isn't
; large enough to force multiple partitions with runtime passthrough).
; With 1 partition, sections are named .text (not .caml.p0).
(rule
 (alias runtest)
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (deps simple_multipart.sections)
 (action (bash "
   if grep -q '\\.caml\\.p1' simple_multipart.sections; then
     echo 'ERROR: simple_multipart.exe has unexpected .caml.p1 section'
     exit 1
   fi
   echo 'OK: simple_multipart.exe has exactly 1 partition'")))

