; Test 7: Verify IGOT relocations are all R_X86_64_64
; Build with -ddissector-partitions, capture partition directory, verify relocs
(rule
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (target igot_verify.output)
 (deps module_a.cmx module_a.o module_b.cmx module_b.o
       module_c.cmx module_c.o cross_partition_main.ml)
 (action
  (with-outputs-to %{target}
   (bash "
     set +o pipefail
     # Build with -ddissector-partitions and capture partition dir from stderr
     OUTPUT=$(%{bin:ocamlopt.opt} -dissector -dissector-partition-size 0.0014 -ddissector-partitions \
       module_a.cmx module_b.cmx module_c.cmx cross_partition_main.ml \
       -o igot_verify.exe 2>&1)
     PARTITION_DIR=$(echo \"$OUTPUT\" | grep 'Dissector partition files' | sed 's/.*in \\(.*\\)):/\\1/')

     echo \"Partition directory: $PARTITION_DIR\"

     # Check that IGOT sections exist and verify relocations
     # Note: section names are .data.igot for Main partition or .caml.pN.data.igot for Large_code
     for part in $PARTITION_DIR/partition*.o.rewritten; do
       if readelf -S \"$part\" 2>/dev/null | grep -q '\\.data\\.igot'; then
         echo \"Found .data.igot section in $(basename $part)\"

         # Count total IGOT relocs and R_X86_64_64 relocs
         TOTAL=$(readelf -r \"$part\" 2>/dev/null | sed -n '/rela.*\\.data\\.igot/,/^Relocation/p' | grep -c '^[0-9a-f]' || true)
         R64=$(readelf -r \"$part\" 2>/dev/null | sed -n '/rela.*\\.data\\.igot/,/^Relocation/p' | grep -c 'R_X86_64_64' || true)

         echo \"Total IGOT relocs: $TOTAL, R_X86_64_64: $R64\"

         if [ \"$TOTAL\" != \"$R64\" ]; then
           echo \"ERROR: Not all IGOT relocations are R_X86_64_64\"
           exit 1
         fi
         echo \"All IGOT relocations are R_X86_64_64 - OK\"
       fi
     done

     echo \"IGOT verification passed\"
   "))))

(rule
 (alias runtest)
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (deps igot_verify.output)
 (action (bash "grep -q 'IGOT verification passed' igot_verify.output || (cat igot_verify.output; exit 1)")))

