; Test 4: Large multi-module test to force multiple partitions
; Uses larger modules to ensure they end up in different partitions,
; guaranteeing cross-partition OCaml function calls and data references.

(rule
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (targets large_module_a.cmi large_module_a.cmx large_module_a.o)
 (deps large_module_a.ml)
 (action
  (run %{bin:ocamlopt.opt} -c %{deps})))

(rule
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (targets large_module_b.cmi large_module_b.cmx large_module_b.o)
 (deps large_module_b.ml large_module_a.cmi large_module_a.cmx)
 (action
  (run %{bin:ocamlopt.opt} -c large_module_b.ml)))

(rule
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (targets large_module_c.cmi large_module_c.cmx large_module_c.o)
 (deps large_module_c.ml large_module_a.cmi large_module_a.cmx
       large_module_b.cmi large_module_b.cmx)
 (action
  (run %{bin:ocamlopt.opt} -c large_module_c.ml)))

; Link with dissector - partition size chosen to force each large module into
; its own partition (each module is ~1.75MB allocated which is larger than
; stdlib.a at ~1.51MB, so a 2MB threshold ensures they end up in separate
; partitions, testing OCaml<->OCaml cross-partition calls with 4 partitions)
(rule
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (target large_cross.exe)
 (deps large_module_a.cmx large_module_a.o
       large_module_b.cmx large_module_b.o
       large_module_c.cmx large_module_c.o
       large_cross_main.ml)
 (action
  (run %{bin:ocamlopt.opt} -dissector -dissector-partition-size 0.002
       large_module_a.cmx large_module_b.cmx large_module_c.cmx large_cross_main.ml
       -o %{target})))

(rule
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (target large_cross.output)
 (deps large_cross.exe)
 (action (with-outputs-to %{target} (run ./large_cross.exe))))

(rule
 (alias runtest)
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (deps large_cross.expected large_cross.output)
 (action (diff large_cross.expected large_cross.output)))

; Verify large_cross.exe has multiple partitions
(rule
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (target large_cross.sections)
 (deps large_cross.exe)
 (action (with-outputs-to %{target}
   (run readelf -S %{deps}))))

(rule
 (alias runtest)
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (deps large_cross.sections)
 (action (bash "grep -q '\\.caml\\.p3' large_cross.sections || (echo 'ERROR: large_cross.exe does not have 4 partitions (expected p0-p3)'; exit 1)")))

; Verify OCaml module symbols are in IGOT (not just runtime symbols)
; This confirms OCaml<->OCaml cross-partition calls work with 4 partitions
; Specifically verifies:
; - The partition containing module_b has IGOT refs to module_a
; - The partition containing module_c has IGOT refs to both module_a AND module_b
(rule
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (target large_cross_igot.output)
 (deps large_module_a.cmx large_module_a.o large_module_b.cmx large_module_b.o
       large_module_c.cmx large_module_c.o large_cross_main.ml)
 (action
  (with-outputs-to %{target}
   (bash "
     set +o pipefail
     # Build with -ddissector-partitions and capture partition dir
     OUTPUT=$(%{bin:ocamlopt.opt} -dissector -dissector-partition-size 0.002 -ddissector-partitions \
       large_module_a.cmx large_module_b.cmx large_module_c.cmx large_cross_main.ml \
       -o large_cross_igot.exe 2>&1)
     PARTITION_DIR=$(echo \"$OUTPUT\" | grep 'Dissector partition files' | sed 's/.*in \\(.*\\)):/\\1/')

     echo \"Partition directory: $PARTITION_DIR\"
     echo \"\"

     # Find which partition contains each module (by looking for defined code_begin symbol)
     PART_WITH_B=\"\"
     PART_WITH_C=\"\"
     for part in $PARTITION_DIR/partition*.o.rewritten; do
       PART_NAME=$(basename $part)
       if nm \"$part\" 2>/dev/null | grep -q ' T camlLarge_module_b__code_begin'; then
         PART_WITH_B=\"$part\"
         echo \"$PART_NAME contains Large_module_b\"
       fi
       if nm \"$part\" 2>/dev/null | grep -q ' T camlLarge_module_c__code_begin'; then
         PART_WITH_C=\"$part\"
         echo \"$PART_NAME contains Large_module_c\"
       fi
     done
     echo \"\"

     # Verify partition with module_b has IGOT ref to module_a
     # Note: section is named .rela.caml.pN.data.igot for Large_code partitions
     echo \"=== Verifying cross-partition IGOT references ===\"
     if [ -z \"$PART_WITH_B\" ]; then
       echo \"ERROR: Could not find partition containing Large_module_b\"
       exit 1
     fi
     IGOT_B=$(readelf -r \"$PART_WITH_B\" 2>/dev/null | sed -n '/rela.*\\.data\\.igot/,/^Relocation/p' | grep 'camlLarge_module_a' || true)
     if [ -z \"$IGOT_B\" ]; then
       echo \"ERROR: Partition with module_b does not have IGOT ref to module_a\"
       exit 1
     fi
     echo \"OK: Partition with module_b has IGOT ref to module_a\"

     # Verify partition with module_c has IGOT refs to both module_a AND module_b
     if [ -z \"$PART_WITH_C\" ]; then
       echo \"ERROR: Could not find partition containing Large_module_c\"
       exit 1
     fi
     IGOT_C_A=$(readelf -r \"$PART_WITH_C\" 2>/dev/null | sed -n '/rela.*\\.data\\.igot/,/^Relocation/p' | grep 'camlLarge_module_a' || true)
     IGOT_C_B=$(readelf -r \"$PART_WITH_C\" 2>/dev/null | sed -n '/rela.*\\.data\\.igot/,/^Relocation/p' | grep 'camlLarge_module_b' || true)
     if [ -z \"$IGOT_C_A\" ]; then
       echo \"ERROR: Partition with module_c does not have IGOT ref to module_a\"
       exit 1
     fi
     if [ -z \"$IGOT_C_B\" ]; then
       echo \"ERROR: Partition with module_c does not have IGOT ref to module_b\"
       exit 1
     fi
     echo \"OK: Partition with module_c has IGOT refs to both module_a and module_b\"

     echo \"\"
     echo \"=== OCaml<->OCaml cross-partition verification passed (4 partitions) ===\"
   "))))

(rule
 (alias runtest)
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (deps large_cross_igot.output)
 (action (bash "grep -q 'cross-partition verification passed' large_cross_igot.output || (cat large_cross_igot.output; exit 1)")))

