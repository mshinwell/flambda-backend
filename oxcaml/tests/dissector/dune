; Test 3: Multi-module test with cross-partition OCaml references
; Uses multiple OCaml modules (A, B, C) that call each other's functions
; and access each other's data. With a small partition size, these modules
; should end up in different partitions, testing IGOT/IPLT for OCaml-to-OCaml
; cross-partition calls.

; Compile individual modules first
(rule
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (targets module_a.cmi module_a.cmx module_a.o)
 (deps module_a.ml)
 (action
  (run %{bin:ocamlopt.opt} -c %{deps})))

(rule
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (targets module_b.cmi module_b.cmx module_b.o)
 (deps module_b.ml module_a.cmi module_a.cmx)
 (action
  (run %{bin:ocamlopt.opt} -c module_b.ml)))

(rule
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (targets module_c.cmi module_c.cmx module_c.o)
 (deps module_c.ml module_a.cmi module_a.cmx module_b.cmi module_b.cmx)
 (action
  (run %{bin:ocamlopt.opt} -c module_c.ml)))

; Link with dissector - tests multi-module OCaml compilation through dissector
; Use partition size just above stdlib.a (~1.4MB) to force 2 partitions
; (stdlib in partition 0, user modules in partition 1)
(rule
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (target cross_partition.exe)
 (deps module_a.cmx module_a.o module_b.cmx module_b.o
       module_c.cmx module_c.o cross_partition_main.ml)
 (action
  (run %{bin:ocamlopt.opt} -dissector -dissector-partition-size 0.0014
       module_a.cmx module_b.cmx module_c.cmx cross_partition_main.ml
       -o %{target})))

(rule
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (target cross_partition.output)
 (deps cross_partition.exe)
 (action (with-outputs-to %{target} (run ./cross_partition.exe))))

(rule
 (alias runtest)
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (deps cross_partition.expected cross_partition.output)
 (action (diff cross_partition.expected cross_partition.output)))

; Verify cross_partition.exe has multiple partitions (look for .caml.p1 sections)
(rule
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (target cross_partition.sections)
 (deps cross_partition.exe)
 (action (with-outputs-to %{target}
   (run readelf -S %{deps}))))

; Verify cross_partition.exe has multiple partitions
(rule
 (alias runtest)
 (enabled_if
  (and (= %{context_name} "main")
       (= %{system} "linux")
       (<> %{env:RUNTIME_DIR=runtime} "runtime4")))
 (deps cross_partition.sections)
 (action (bash "grep -q '\\.caml\\.p1' cross_partition.sections || (echo 'ERROR: cross_partition.exe does not have multiple partitions'; exit 1)")))

